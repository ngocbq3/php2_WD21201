 <?php $__currentLoopData = $articles; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $article): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?= $article->id ?></td>
 <td><?= $article->title ?></td>
 <td><img src="<?php echo \htmlentities(BASE_URL . $article->image??'', ENT_QUOTES, 'UTF-8', false); ?>" width="100" alt=""></td>
 <td><?= $article->name ?></td>
 <td>
 Edit/Delete
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </table>
 </div>
